# OpenRouter: chat. TTS uses the local VieNeu service; STT uses local FunASR.
# Model chọn theo đo thực tế với tiếng Việt (tình huống sơ cứu), cân bằng tốc độ và độ chính xác.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM: Gemma 4 31B (định tuyến provider độ trễ thấp), gọi tool đúng 18/18, TTFT ~0,9 s, không bịa hướng dẫn y tế.
# Thay thế: deepseek/deepseek-v4.1-flash (nhanh, rẻ nhưng tự thêm hướng dẫn ngoài dữ liệu)
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# STT: local Fun-ASR-MLT-Nano-2512 service.
FUNASR_STT_URL=http://127.0.0.1:7860/api/transcribe
# The local FunASR demo is configured to transcribe Vietnamese.
VOICE_LANGUAGE=vi

# TTS: local VieNeu-TTS v3 Turbo server (CPU int8, streaming).
# Local server source: %LOCALAPPDATA%\demo-voice\VieNeu-TTS; run `uv run python -m apps.openai_speech` there.
TTS_BASE_URL=http://127.0.0.1:8000/v1
OPENROUTER_TTS_MODEL=vieneu-v3-turbo
OPENROUTER_TTS_VOICE=Mai Anh
OPENROUTER_TTS_SPEED=1.2
OPENROUTER_TTS_SAMPLE_RATE=48000

# LiveKit server local: `docker compose up -d` (chế độ --dev, key devkey / secret secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
