# Copy this file to .env and add your own OpenRouter key.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Local ASR demo endpoint. Start the root asr/ service or set another compatible URL.
FUNASR_STT_URL=http://127.0.0.1:7860/api/transcribe
VOICE_LANGUAGE=vi

# Local/hosted OpenAI-compatible VieNeu TTS endpoint. The server itself is external to this repo.
TTS_BASE_URL=http://127.0.0.1:8000/v1
OPENROUTER_TTS_MODEL=vieneu-v3-turbo
OPENROUTER_TTS_VOICE=Mai Anh
OPENROUTER_TTS_SPEED=1.2
OPENROUTER_TTS_SAMPLE_RATE=48000

# For the bundled local `docker compose up -d livekit` development server only.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret